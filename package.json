{
  "name": "medic-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:booking-same-patient": "playwright test e2e/appointment-same-patient-race.spec.ts",
    "test:e2e:booking-different-slots": "playwright test e2e/appointment-different-slots-race.spec.ts",
    "test:e2e:booking-race": "playwright test e2e/appointment-race-demo.spec.ts --grep=\"two real patients submit the same appointment slot at once\"",
    "test:e2e:reschedule-conflict": "playwright test e2e/appointment-reschedule-conflict.spec.ts",
    "demo:booking-race": "playwright test --config=playwright.demo.config.ts --headed e2e/appointment-race-demo.spec.ts --grep=\"two real patients submit the same appointment slot at once\"",
    "demo:booking-same-patient": "playwright test --config=playwright.demo.config.ts --headed e2e/appointment-same-patient-race.spec.ts",
    "demo:booking-different-slots": "playwright test --config=playwright.demo.config.ts --headed e2e/appointment-different-slots-race.spec.ts",
    "demo:reschedule-conflict": "playwright test --config=playwright.demo.config.ts --headed e2e/appointment-reschedule-conflict.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
